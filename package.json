{
  "name": "@jxpeng98/martian",
  "version": "1.3.2-beta.3",
  "description": "Converts Markdown to Notion Blocks and RichText",
  "repository": "https://github.com/jxpeng98/martian",
  "type": "module",
  "exports": {
    ".": {
      "import": "./build/src/index.js",
      "types": "./build/src/index.d.ts"
    }
  },
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "test": "vitest run test",
    "lint": "eslint .",
    "clean": "rimraf build",
    "precompile": "node --import tsx scripts/languageMap.ts",
    "compile": "tsc",
    "fix": "eslint . --fix && prettier . --write",
    "prepare": "pnpm run compile",
    "pretest": "pnpm run compile",
    "posttest": "pnpm run lint",
    "ci-check": "rm -rf dist node_modules && pnpm install --frozen-lockfile && pnpm run compile && pnpm run test && pnpm run lint",
    "bump:prerelease": "node scripts/bump-version.mjs prerelease beta",
    "bump:release": "node scripts/bump-version.mjs patch",
    "bump:release:minor": "node scripts/bump-version.mjs minor",
    "bump:release:major": "node scripts/bump-version.mjs major",
    "publish:beta": "pnpm publish --tag beta --no-git-checks",
    "publish:latest": "pnpm publish --no-git-checks"
  },
  "keywords": [
    "markdown",
    "notion",
    "parser",
    "gfm"
  ],
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "author": "Richard Robinson",
  "license": "ISC",
  "dependencies": {
    "@types/unist": "^3.0.3",
    "@notionhq/client": "^5.3.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.17.51",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "linguist-languages": "^9.0.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.2",
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ]
}
